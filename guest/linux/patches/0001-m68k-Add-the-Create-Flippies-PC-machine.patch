diff --git a/arch/m68k/include/asm/flippies.h b/arch/m68k/include/asm/flippies.h
new file mode 100644
index 0000000..dbb2e57
--- /dev/null
+++ b/arch/m68k/include/asm/flippies.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The Create Flippies PC: physical memory map and interrupt controller lines of its 68040
+ * machine. Everything from 0xff000000 up is mapped one to one by a transparent translation
+ * register (head.S), so these addresses work before and after the MMU is on.
+ *
+ * Only #defines: head.S includes this file too.
+ */
+#ifndef __ASM_M68K_FLIPPIES_H
+#define __ASM_M68K_FLIPPIES_H
+
+/* Device register windows, 4 KiB each */
+#define FLIPPIES_SYSCON_BASE	0xfff00000
+#define FLIPPIES_PIC_BASE	0xfff01000
+#define FLIPPIES_COM1_BASE	0xfff02000
+#define FLIPPIES_COM2_BASE	0xfff03000
+#define FLIPPIES_PS2_BASE	0xfff04000
+#define FLIPPIES_HDD_BASE	0xfff05000
+#define FLIPPIES_VGA0_BASE	0xfff06000
+#define FLIPPIES_TIMER_BASE	0xfff07000
+#define FLIPPIES_RTC_BASE	0xfff08000
+#define FLIPPIES_COM3_BASE	0xfff09000
+#define FLIPPIES_FDC_BASE	0xfff0a000
+#define FLIPPIES_NIC_BASE	0xfff0b000
+#define FLIPPIES_VGA1_BASE	0xfff0c000
+#define FLIPPIES_VGA2_BASE	0xfff0d000
+#define FLIPPIES_WINDOW_SIZE	0x1000
+
+/* The two PS/2 ports share the PS/2 window */
+#define FLIPPIES_PS2_PORT_SIZE	0x10
+
+/* Framebuffers, one per display */
+#define FLIPPIES_VRAM0_BASE	0xffe00000
+#define FLIPPIES_VRAM1_BASE	0xffe80000
+#define FLIPPIES_VRAM2_BASE	0xffd80000
+#define FLIPPIES_VRAM_SIZE	0x80000
+
+/* Interrupt controller lines; line 0 does not exist */
+#define FLIPPIES_LINE_COM1	1
+#define FLIPPIES_LINE_COM2	2
+#define FLIPPIES_LINE_PS2_0	3
+#define FLIPPIES_LINE_PS2_1	4
+#define FLIPPIES_LINE_HDD	5
+#define FLIPPIES_LINE_VGA0	6
+#define FLIPPIES_LINE_TIMER	7
+#define FLIPPIES_LINE_COM3	8
+#define FLIPPIES_LINE_FDC	9
+#define FLIPPIES_LINE_NIC	10
+#define FLIPPIES_LINE_VGA1	11
+#define FLIPPIES_LINE_VGA2	12
+#define FLIPPIES_LINES		32
+
+/* Linux irq of a controller line: the lines follow the autovector irqs (IRQ_USER is 8) */
+#define FLIPPIES_IRQ_BASE	8
+#define FLIPPIES_IRQ(line)	(FLIPPIES_IRQ_BASE + (line))
+
+#endif /* __ASM_M68K_FLIPPIES_H */
