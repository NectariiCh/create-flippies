@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The Create Flippies PC, a 68040 machine emulated by the Create Flippies mod for Minecraft:
+ * machine setup, reset and power off.
+ */
+
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/irqflags.h>
+#include <linux/reboot.h>
+#include <linux/string.h>
+
+#include <asm/config.h>
+#include <asm/flippies.h>
+#include <asm/machdep.h>
+
+#include "flippies.h"
+
+/* System controller: POWER takes a command, acted on after the writing instruction */
+#define SYSCON_POWER		0x00
+#define SYSCON_POWER_OFF	0x5555
+#define SYSCON_POWER_RESET	0x7777
+
+static void __iomem *const syscon = (void __iomem *)FLIPPIES_SYSCON_BASE;
+
+static void flippies_get_model(char *model)
+{
+	/* model is 80 characters long */
+	strscpy(model, "Create Flippies PC", 80);
+}
+
+static void flippies_reset(void)
+{
+	local_irq_disable();
+	iowrite32be(SYSCON_POWER_RESET, syscon + SYSCON_POWER);
+	while (1)
+		;
+}
+
+static void flippies_power_off(void)
+{
+	local_irq_disable();
+	iowrite32be(SYSCON_POWER_OFF, syscon + SYSCON_POWER);
+	while (1)
+		;
+}
+
+void __init config_flippies(void)
+{
+	mach_init_IRQ = flippies_init_IRQ;
+	mach_sched_init = flippies_sched_init;
+	mach_get_model = flippies_get_model;
+	mach_reset = flippies_reset;
+	mach_halt = flippies_power_off;
+
+	register_platform_power_off(flippies_power_off);
+}
