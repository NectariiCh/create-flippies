diff --git a/arch/m68k/flippies/ints.c b/arch/m68k/flippies/ints.c
new file mode 100644
index 0000000..bcfc945
--- /dev/null
+++ b/arch/m68k/flippies/ints.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Interrupt controller of the Create Flippies PC: 31 level-sensitive lines (1 to 31), each
+ * routed to one of 8 outputs. Every line stays routed to output 0, which reaches the CPU as
+ * autovector level 4. The level 4 handler asks CLAIM for the lowest pending and enabled line
+ * until there is none; each line is Linux irq FLIPPIES_IRQ(line).
+ */
+
+#include <linux/bits.h>
+#include <linux/build_bug.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/ioport.h>
+#include <linux/irq.h>
+#include <linux/irqdesc.h>
+
+#include <asm/flippies.h>
+#include <asm/irq.h>
+
+#include "flippies.h"
+
+#define PIC_ENABLE	0x04
+#define PIC_CLAIM	0x08
+#define PIC_ROUTE(n)	(0x10 + 4 * (n))
+
+static void __iomem *const pic = (void __iomem *)FLIPPIES_PIC_BASE;
+
+static struct resource pic_res = DEFINE_RES_MEM_NAMED(FLIPPIES_PIC_BASE,
+						      FLIPPIES_WINDOW_SIZE,
+						      "flippies-pic");
+
+/* ENABLE as last written; the irq core calls the chip with interrupts off */
+static u32 pic_enabled;
+
+static void flippies_irq_mask(struct irq_data *data)
+{
+	pic_enabled &= ~BIT(data->irq - FLIPPIES_IRQ_BASE);
+	iowrite32be(pic_enabled, pic + PIC_ENABLE);
+}
+
+static void flippies_irq_unmask(struct irq_data *data)
+{
+	pic_enabled |= BIT(data->irq - FLIPPIES_IRQ_BASE);
+	iowrite32be(pic_enabled, pic + PIC_ENABLE);
+}
+
+static struct irq_chip flippies_irq_chip = {
+	.name		= "flippies",
+	.irq_mask	= flippies_irq_mask,
+	.irq_unmask	= flippies_irq_unmask,
+};
+
+static void flippies_pic_handler(struct irq_desc *desc)
+{
+	unsigned int line;
+
+	while ((line = ioread32be(pic + PIC_CLAIM)) != 0)
+		generic_handle_irq(FLIPPIES_IRQ(line));
+}
+
+void __init flippies_init_IRQ(void)
+{
+	int i;
+
+	BUILD_BUG_ON(FLIPPIES_IRQ_BASE != IRQ_USER);
+	BUILD_BUG_ON(FLIPPIES_IRQ(FLIPPIES_LINES) > NR_IRQS);
+
+	if (request_resource(&iomem_resource, &pic_res))
+		pr_err("flippies: cannot claim the interrupt controller window\n");
+
+	iowrite32be(0, pic + PIC_ENABLE);
+	for (i = 0; i < 4; i++)
+		iowrite32be(0, pic + PIC_ROUTE(i));
+
+	m68k_setup_irq_controller(&flippies_irq_chip, handle_level_irq,
+				  FLIPPIES_IRQ(1), FLIPPIES_LINES - 1);
+	irq_set_chained_handler(IRQ_AUTO_4, flippies_pic_handler);
+}
diff --git a/arch/m68k/flippies/timer.c b/arch/m68k/flippies/timer.c
new file mode 100644
index 0000000..3711c88
--- /dev/null
+++ b/arch/m68k/flippies/timer.c
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Interval timer of the Create Flippies PC: a 64-bit counter of microseconds since power on
+ * (reading COUNTER_LO latches COUNTER_HI) and a countdown in microseconds that raises its line
+ * once, or periodically, when it expires. The counter is the clocksource and sched_clock, the
+ * countdown the clock event device.
+ */
+
+#include <linux/bits.h>
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/ioport.h>
+#include <linux/irqflags.h>
+#include <linux/sched_clock.h>
+
+#include <asm/flippies.h>
+
+#include "flippies.h"
+
+#define TIMER_COUNTER_LO	0x00
+#define TIMER_COUNTER_HI	0x04
+#define TIMER_PERIOD		0x08
+#define TIMER_CTRL		0x0c
+#define TIMER_STATUS		0x10
+
+#define TIMER_CTRL_ENABLE	BIT(0)
+#define TIMER_CTRL_IRQ_ENABLE	BIT(1)
+#define TIMER_CTRL_ONE_SHOT	BIT(2)
+#define TIMER_STATUS_EXPIRED	BIT(0)
+
+#define TIMER_HZ		1000000
+
+/*
+ * Longest countdown, 1 s. A tickless idle then wakes at least once a second: timekeeping catches
+ * up on an idle period with interrupts off, at about 20 us per idle second on a 25 MHz 68040,
+ * and after an hour of idle that would hold interrupts off long enough to overrun the 16-byte
+ * COM receive FIFOs.
+ */
+#define TIMER_MAX_DELTA		TIMER_HZ
+
+static void __iomem *const timer = (void __iomem *)FLIPPIES_TIMER_BASE;
+
+static struct resource timer_res = DEFINE_RES_MEM_NAMED(FLIPPIES_TIMER_BASE,
+							FLIPPIES_WINDOW_SIZE,
+							"flippies-timer");
+
+static u64 notrace flippies_timer_count(void)
+{
+	unsigned long flags;
+	u32 lo, hi;
+
+	/* reading COUNTER_LO latches COUNTER_HI: no other reader may come between */
+	raw_local_irq_save(flags);
+	lo = ioread32be(timer + TIMER_COUNTER_LO);
+	hi = ioread32be(timer + TIMER_COUNTER_HI);
+	raw_local_irq_restore(flags);
+
+	return (u64)hi << 32 | lo;
+}
+
+static u64 flippies_clocksource_read(struct clocksource *cs)
+{
+	return flippies_timer_count();
+}
+
+static struct clocksource flippies_clocksource = {
+	.name	= "flippies-timer",
+	.rating	= 300,
+	.read	= flippies_clocksource_read,
+	.mask	= CLOCKSOURCE_MASK(64),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+static int flippies_timer_shutdown(struct clock_event_device *evt)
+{
+	iowrite32be(0, timer + TIMER_CTRL);
+	iowrite32be(TIMER_STATUS_EXPIRED, timer + TIMER_STATUS);
+	return 0;
+}
+
+static int flippies_timer_set_periodic(struct clock_event_device *evt)
+{
+	iowrite32be(DIV_ROUND_CLOSEST(TIMER_HZ, HZ), timer + TIMER_PERIOD);
+	iowrite32be(TIMER_CTRL_ENABLE | TIMER_CTRL_IRQ_ENABLE, timer + TIMER_CTRL);
+	return 0;
+}
+
+static int flippies_timer_set_next_event(unsigned long delta,
+					 struct clock_event_device *evt)
+{
+	iowrite32be(delta, timer + TIMER_PERIOD);
+	iowrite32be(TIMER_CTRL_ENABLE | TIMER_CTRL_IRQ_ENABLE | TIMER_CTRL_ONE_SHOT,
+		    timer + TIMER_CTRL);
+	return 0;
+}
+
+static struct clock_event_device flippies_clockevent = {
+	.name			= "flippies-timer",
+	.features		= CLOCK_EVT_FEAT_PERIODIC | CLOCK_EVT_FEAT_ONESHOT,
+	.rating			= 300,
+	.set_state_shutdown	= flippies_timer_shutdown,
+	.set_state_periodic	= flippies_timer_set_periodic,
+	.set_state_oneshot	= flippies_timer_shutdown,
+	.set_next_event		= flippies_timer_set_next_event,
+	.tick_resume		= flippies_timer_shutdown,
+};
+
+static irqreturn_t flippies_timer_interrupt(int irq, void *dev_id)
+{
+	struct clock_event_device *evt = dev_id;
+
+	iowrite32be(TIMER_STATUS_EXPIRED, timer + TIMER_STATUS);
+	evt->event_handler(evt);
+
+	return IRQ_HANDLED;
+}
+
+void __init flippies_sched_init(void)
+{
+	if (request_resource(&iomem_resource, &timer_res))
+		pr_err("flippies: cannot claim the timer window\n");
+
+	flippies_timer_shutdown(&flippies_clockevent);
+	if (request_irq(FLIPPIES_IRQ(FLIPPIES_LINE_TIMER), flippies_timer_interrupt,
+			IRQF_TIMER, "timer", &flippies_clockevent))
+		pr_err("flippies: cannot register the timer interrupt\n");
+
+	flippies_clockevent.cpumask = cpu_possible_mask;
+	clockevents_config_and_register(&flippies_clockevent, TIMER_HZ, 1, TIMER_MAX_DELTA);
+	clocksource_register_hz(&flippies_clocksource, TIMER_HZ);
+	sched_clock_register(flippies_timer_count, 64, TIMER_HZ);
+}
