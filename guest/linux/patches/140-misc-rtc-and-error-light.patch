diff --git a/drivers/leds/leds-flippies.c b/drivers/leds/leds-flippies.c
new file mode 100644
index 0000000..3f079c5
--- /dev/null
+++ b/drivers/leds/leds-flippies.c
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The error light on the case of the Create Flippies PC, bit 0 of the system controller's LEDS
+ * register. The case shows it together with the emulator's own error conditions, so software in
+ * the PC can light it to report a fault. It also lights on a kernel panic.
+ */
+
+#include <linux/bits.h>
+#include <linux/io.h>
+#include <linux/leds.h>
+#include <linux/module.h>
+#include <linux/platform_data/flippies.h>
+#include <linux/platform_device.h>
+
+#define SYSCON_LEDS		0x34
+#define SYSCON_LEDS_ERROR	BIT(0)
+
+struct flippies_led {
+	struct led_classdev cdev;
+	void __iomem *base;
+};
+
+static void flippies_led_set(struct led_classdev *cdev, enum led_brightness value)
+{
+	struct flippies_led *led = container_of(cdev, struct flippies_led, cdev);
+
+	iowrite32be(value ? SYSCON_LEDS_ERROR : 0, led->base + SYSCON_LEDS);
+}
+
+static enum led_brightness flippies_led_get(struct led_classdev *cdev)
+{
+	struct flippies_led *led = container_of(cdev, struct flippies_led, cdev);
+
+	return ioread32be(led->base + SYSCON_LEDS) & SYSCON_LEDS_ERROR ? LED_ON : LED_OFF;
+}
+
+static int flippies_led_probe(struct platform_device *pdev)
+{
+	struct flippies_led *led;
+
+	led = devm_kzalloc(&pdev->dev, sizeof(*led), GFP_KERNEL);
+	if (!led)
+		return -ENOMEM;
+
+	led->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(led->base))
+		return PTR_ERR(led->base);
+
+	led->cdev.name = "flippies::fault";
+	led->cdev.max_brightness = LED_ON;
+	led->cdev.brightness_set = flippies_led_set;
+	led->cdev.brightness_get = flippies_led_get;
+	led->cdev.flags = LED_PANIC_INDICATOR;
+	led->cdev.brightness = flippies_led_get(&led->cdev);
+
+	return devm_led_classdev_register(&pdev->dev, &led->cdev);
+}
+
+static struct platform_driver flippies_led_driver = {
+	.probe	= flippies_led_probe,
+	.driver	= {
+		.name	= FLIPPIES_SYSCON_NAME,
+	},
+};
+module_platform_driver(flippies_led_driver);
+
+MODULE_DESCRIPTION("Create Flippies PC error light driver");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:" FLIPPIES_SYSCON_NAME);
