diff --git a/drivers/rtc/rtc-flippies.c b/drivers/rtc/rtc-flippies.c
new file mode 100644
index 0000000..d3ba31d
--- /dev/null
+++ b/drivers/rtc/rtc-flippies.c
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Real-time clock of the Create Flippies PC: a 64-bit count of seconds since the Unix epoch that
+ * keeps running while the PC is reset or switched off. Reading SECONDS_LO latches SECONDS_HI;
+ * writing SET_HI sets the clock to SET_HI:SET_LO. It has no alarm and no interrupt.
+ */
+
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_data/flippies.h>
+#include <linux/platform_device.h>
+#include <linux/rtc.h>
+
+#define RTC_SECONDS_LO	0x00
+#define RTC_SECONDS_HI	0x04
+#define RTC_SET_LO	0x08
+#define RTC_SET_HI	0x0c
+
+/*
+ * The rtc core calls read_time and set_time with rtc->ops_lock held, so no other reader can
+ * come between a SECONDS_LO read and the SECONDS_HI read it latched.
+ */
+static int flippies_rtc_read_time(struct device *dev, struct rtc_time *tm)
+{
+	void __iomem *base = dev_get_drvdata(dev);
+	u32 lo, hi;
+
+	lo = ioread32be(base + RTC_SECONDS_LO);
+	hi = ioread32be(base + RTC_SECONDS_HI);
+	rtc_time64_to_tm((time64_t)((u64)hi << 32 | lo), tm);
+
+	return 0;
+}
+
+static int flippies_rtc_set_time(struct device *dev, struct rtc_time *tm)
+{
+	void __iomem *base = dev_get_drvdata(dev);
+	u64 secs = rtc_tm_to_time64(tm);
+
+	iowrite32be(lower_32_bits(secs), base + RTC_SET_LO);
+	iowrite32be(upper_32_bits(secs), base + RTC_SET_HI);
+
+	return 0;
+}
+
+static const struct rtc_class_ops flippies_rtc_ops = {
+	.read_time	= flippies_rtc_read_time,
+	.set_time	= flippies_rtc_set_time,
+};
+
+static int flippies_rtc_probe(struct platform_device *pdev)
+{
+	struct rtc_device *rtc;
+	void __iomem *base;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+	platform_set_drvdata(pdev, base);
+
+	rtc = devm_rtc_allocate_device(&pdev->dev);
+	if (IS_ERR(rtc))
+		return PTR_ERR(rtc);
+
+	rtc->ops = &flippies_rtc_ops;
+	rtc->range_max = U64_MAX;
+	clear_bit(RTC_FEATURE_UPDATE_INTERRUPT, rtc->features);
+
+	return devm_rtc_register_device(rtc);
+}
+
+static struct platform_driver flippies_rtc_driver = {
+	.probe	= flippies_rtc_probe,
+	.driver	= {
+		.name	= FLIPPIES_RTC_NAME,
+	},
+};
+module_platform_driver(flippies_rtc_driver);
+
+MODULE_DESCRIPTION("Create Flippies PC real-time clock driver");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:" FLIPPIES_RTC_NAME);
