diff --git a/drivers/input/serio/flippies_ps2.c b/drivers/input/serio/flippies_ps2.c
new file mode 100644
index 0000000..081bb12
--- /dev/null
+++ b/drivers/input/serio/flippies_ps2.c
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PS/2 ports of the Create Flippies PC (arch/m68k/flippies).
+ *
+ * The controller has two identical ports, each a 16-byte window: DATA (a read pops the next byte
+ * from the device, a write sends the device a byte), STATUS (bit 0 a byte is ready, bit 1 a byte
+ * was lost, write 1 to clear it) and CTRL (bit 0 interrupt enable, bit 1 port enable). Each port
+ * has its own interrupt line, high while a byte is ready and the interrupt is enabled. Bytes pass
+ * unchanged, so a keyboard speaks scancode set 2 and each port is a plain SERIO_8042 port that
+ * atkbd or psmouse binds to, whichever device is plugged in.
+ */
+
+#include <linux/bits.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_data/flippies.h>
+#include <linux/platform_device.h>
+#include <linux/serio.h>
+#include <linux/slab.h>
+
+#define FLIPPIES_PS2_DATA		0x0
+#define FLIPPIES_PS2_STATUS		0x4
+#define FLIPPIES_PS2_CTRL		0x8
+
+#define FLIPPIES_PS2_STATUS_RX_READY	BIT(0)
+#define FLIPPIES_PS2_STATUS_OVERRUN	BIT(1)
+#define FLIPPIES_PS2_CTRL_IRQ		BIT(0)
+#define FLIPPIES_PS2_CTRL_ENABLE	BIT(1)
+
+struct flippies_ps2 {
+	struct serio *serio;
+	void __iomem *regs;
+};
+
+static irqreturn_t flippies_ps2_interrupt(int irq, void *dev_id)
+{
+	struct flippies_ps2 *ps2 = dev_id;
+	irqreturn_t ret = IRQ_NONE;
+	u32 status;
+	u8 data;
+
+	while ((status = ioread32be(ps2->regs + FLIPPIES_PS2_STATUS)) &
+	       FLIPPIES_PS2_STATUS_RX_READY) {
+		/*
+		 * A lost byte needs no flag: a keyboard queues its overrun code in its place and a
+		 * mouse drops whole packets.
+		 */
+		if (status & FLIPPIES_PS2_STATUS_OVERRUN)
+			iowrite32be(FLIPPIES_PS2_STATUS_OVERRUN,
+				    ps2->regs + FLIPPIES_PS2_STATUS);
+		data = ioread32be(ps2->regs + FLIPPIES_PS2_DATA);
+		serio_interrupt(ps2->serio, data, 0);
+		ret = IRQ_HANDLED;
+	}
+
+	return ret;
+}
+
+static int flippies_ps2_write(struct serio *serio, unsigned char data)
+{
+	struct flippies_ps2 *ps2 = serio->port_data;
+
+	iowrite32be(data, ps2->regs + FLIPPIES_PS2_DATA);
+	return 0;
+}
+
+static int flippies_ps2_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct flippies_ps2 *ps2;
+	struct serio *serio;
+	int irq, ret;
+
+	ps2 = devm_kzalloc(dev, sizeof(*ps2), GFP_KERNEL);
+	if (!ps2)
+		return -ENOMEM;
+
+	ps2->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(ps2->regs))
+		return PTR_ERR(ps2->regs);
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	/* quiet until the serio port is registered */
+	iowrite32be(0, ps2->regs + FLIPPIES_PS2_CTRL);
+
+	serio = kzalloc(sizeof(*serio), GFP_KERNEL);
+	if (!serio)
+		return -ENOMEM;
+	serio->id.type = SERIO_8042;
+	serio->write = flippies_ps2_write;
+	serio->port_data = ps2;
+	serio->dev.parent = dev;
+	snprintf(serio->name, sizeof(serio->name), "Flippies PS/2 port %d",
+		 pdev->id);
+	snprintf(serio->phys, sizeof(serio->phys), "%s/serio0", dev_name(dev));
+	ps2->serio = serio;
+
+	ret = devm_request_irq(dev, irq, flippies_ps2_interrupt, 0,
+			       dev_name(dev), ps2);
+	if (ret) {
+		kfree(serio);
+		return ret;
+	}
+
+	serio_register_port(serio);
+	platform_set_drvdata(pdev, ps2);
+
+	/*
+	 * What the device said before anyone listened, its power-on bytes, is stale. From here on
+	 * the port interrupt stays enabled, as i8042's do, whether or not a driver is bound: a byte
+	 * on a port with no driver makes serio rescan it, which is how a keyboard or mouse plugged
+	 * in after boot gets its driver.
+	 */
+	while (ioread32be(ps2->regs + FLIPPIES_PS2_STATUS) &
+	       FLIPPIES_PS2_STATUS_RX_READY)
+		ioread32be(ps2->regs + FLIPPIES_PS2_DATA);
+	iowrite32be(FLIPPIES_PS2_STATUS_OVERRUN, ps2->regs + FLIPPIES_PS2_STATUS);
+	iowrite32be(FLIPPIES_PS2_CTRL_IRQ | FLIPPIES_PS2_CTRL_ENABLE,
+		    ps2->regs + FLIPPIES_PS2_CTRL);
+	return 0;
+}
+
+static void flippies_ps2_remove(struct platform_device *pdev)
+{
+	struct flippies_ps2 *ps2 = platform_get_drvdata(pdev);
+
+	/* no interrupt may reach the serio port once it is gone */
+	iowrite32be(0, ps2->regs + FLIPPIES_PS2_CTRL);
+	serio_unregister_port(ps2->serio);
+}
+
+static struct platform_driver flippies_ps2_driver = {
+	.probe	= flippies_ps2_probe,
+	.remove	= flippies_ps2_remove,
+	.driver	= {
+		.name	= FLIPPIES_PS2_NAME,
+	},
+};
+module_platform_driver(flippies_ps2_driver);
+
+MODULE_DESCRIPTION("Create Flippies PC PS/2 port driver");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:" FLIPPIES_PS2_NAME);
