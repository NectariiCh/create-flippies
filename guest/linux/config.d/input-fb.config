# Displays and PS/2 input of the Create Flippies kernel (spec 12.6): flippiesfb on the three
# displays with the framebuffer console on fb0, and the two PS/2 ports for the stock atkbd and
# psmouse drivers, with evdev for /dev/input/event*.

# The three displays, /dev/fb0 to /dev/fb2 (FB_DEVICE gives the device files and sysfs), and the
# text console on fb0 (tty1 and up)
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_FLIPPIES=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x16=y

# PS/2 ports 0 and 1; a keyboard or a mouse on either
CONFIG_SERIO=y
CONFIG_SERIO_FLIPPIES=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_EVDEV=y

