# The hard disk and the floppy drive (spec 12.6): the flippies-hdd driver for fhda, with MBR
# partitions (on in the base already), and fhdb; ext4 for the root file system, which also
# mounts ext2 and ext3.
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_FLIPPIES=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
