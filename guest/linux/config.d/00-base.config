# Base of the Create Flippies kernel (spec 12.6), merged onto allnoconfig by build.sh before the
# other fragments in this folder. Step one of the port: the platform, the serial console and an
# initramfs. Everything is built in; there are no modules.
CONFIG_LOCALVERSION="-flippies"
# CONFIG_LOCALVERSION_AUTO is not set

# The machine: a 68040 with its MMU, the Create Flippies PC and no other platform
CONFIG_MMU=y
CONFIG_M68KCLASSIC=y
CONFIG_M68040=y
# CONFIG_M68020 is not set
# CONFIG_M68030 is not set
# CONFIG_M68060 is not set
CONFIG_FLIPPIES=y
CONFIG_ADVANCED=y
CONFIG_SINGLE_MEMORY_CHUNK=y
# CONFIG_RMW_INSNS is not set
# CONFIG_M68KFPU_EMU is not set

# Tickless idle, so a waiting PC costs the host nothing between timer events
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y

# Userland: ELF and #! scripts, an initramfs in plain cpio from the boot loader. Debian's glibc
# for m68k makes the 32-bit time system calls whenever a value fits (clock_nanosleep for sleep),
# so they must exist next to the 64-bit ones.
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# COM1 to COM3 on the stock 8250 driver, console on ttyS0
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=3
CONFIG_SERIAL_8250_RUNTIME_UARTS=3
# CONFIG_SERIAL_8250_16550A_VARIANTS is not set
