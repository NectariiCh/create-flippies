# Networking (spec 12.6): IPv4 over the PC's network card (eth0, flippies-nic) to the modem of
# spec 12.4, which hands out the address by DHCP. AF_PACKET is for DHCP clients (busybox udhcpc,
# dhcpcd), which send and receive before the interface has an address.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_FLIPPIES_NIC=y
