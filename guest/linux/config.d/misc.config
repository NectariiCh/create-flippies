# The real-time clock and the case's error light (spec 12.6, flippies-rtc and flippies-syscon).
# Merged by build.sh after 00-base.config.

# The clock: read and set through /dev/rtc0 (hwclock), and the system time taken from it at boot
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_PROC=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_DRV_FLIPPIES=y

# The error light as an LED class device (/sys/class/leds/flippies::fault), lit on a panic too
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_FLIPPIES=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_PANIC=y
