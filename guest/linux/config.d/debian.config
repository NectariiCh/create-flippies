# What the Debian image (spec 12.8) needs from the kernel: sysvinit-core and its initscripts,
# udev (xserver-xorg-core depends on it), Xorg with the fbdev and evdev drivers, xterm and
# ifupdown with dhcpcd. Merged by build.sh with the other fragments; it only adds or repeats
# values, so the merge order does not change the result.
#
# Many of these are on already (allnoconfig defaults or another fragment). They are listed again
# so the build stops if one ever goes missing: build.sh refuses a fragment value the kernel did
# not take.

# New for Debian. System V IPC: Xorg's MIT-SHM extension and much of the userland. POSIX
# message queues: glibc's mq_* calls. inotify: udevd sets up its inotify watch at start-up.
# Swap: the 128 MiB swap partition of spec 12.7.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_INOTIFY_USER=y
CONFIG_SWAP=y

# Already on, needed by udev 262 (its README's kernel list, less CGROUPS: udevd only logs
# "Failed to get cgroup, ignoring" without it, and nothing else in a sysvinit system uses it)
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_FHANDLE=y
CONFIG_UNIX=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
# CONFIG_UEVENT_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER is not set

# Already on, needed by the rest of the userland: ELF and #! programs, futexes for glibc's
# threads and locks, tmpfs for /run and /dev/shm, Unix 98 ptys for xterm, the virtual terminals
# and fbcon that Xorg switches away from, evdev for Xorg's input, IPv4 for ifupdown and dhcpcd,
# ext4 on an MBR partition for the root file system
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_UNIX98_PTYS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INET=y
CONFIG_EXT4_FS=y
CONFIG_MSDOS_PARTITION=y

# Left off to keep the kernel small: IPv6 (ifupdown and dhcpcd run on IPv4 alone), POSIX ACLs
# on tmpfs and ext4 (only systemd-logind's device access uses them), cgroups (above).
